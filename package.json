{
  "name": "textile-export",
  "version": "0.2.0",
  "description": "Adds \"Export to Textile\" to the file context menu, copying the note as Textile markup.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "npm run validate:manifest && npm run typecheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "release": "node scripts/release.mjs",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:manifest": "node scripts/validate-manifest.mjs"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "esbuild": "0.25.5",
    "globals": "^17.6.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  }
}
