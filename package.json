{
  "name": "redmine-export",
  "version": "0.1.0",
  "description": "Adds \"Export to Redmine\" to the file context menu, copying the note as Redmine wiki (Textile) markup.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "esbuild": "0.25.5",
    "globals": "^17.6.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  }
}
